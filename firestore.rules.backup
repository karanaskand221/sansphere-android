rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chat rooms
    match /chats/{chatId} {
      // YOUR EXISTING CHAT RULES
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Academic Vault
    match /academic_vault/{resourceId} {

      // Logged-in users can see resources
      allow read: if request.auth != null;

      // Logged-in users can upload their own resources
      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.status == 'published';

      // Owner can update/delete their own resource
      allow update, delete: if request.auth != null
        && resource.data.uploaderId == request.auth.uid;
    }

  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chat rooms
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Academic Vault
    match /academic_vault/{resourceId} {

      // Authenticated users can view resources
      allow read: if request.auth != null;

      // Authenticated users can create their own published resources
      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.status == 'published';

      // Owner can update/delete their own resource
      allow update, delete: if request.auth != null
        && resource.data.uploaderId == request.auth.uid;
    }
  }
}

rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /*
     * USER PROFILES
     *
     * Users may create/update profile fields only.
     * Wallet/economy fields are server-owned.
     */
    match /users/{userId} {

      allow read: if request.auth != null;

      /*
       * SAVED RESOURCES
       *
       * Each user can only read/write their own saved-resource
       * subcollection. Saved resources contain only the resource ID
       * and save timestamp; the actual resource lives in sanvault.
       */
      match /saved_resources/{resourceId} {
        // Saved resources are private to their owner.
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.followersCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.reviewsCount == 0
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'college',
          'branch',
          'year',
          'bio',
          'specification',
          'createdAt',
          'lastProfileUpdate',
          'referralCode',
          'referralRewardClaimed',
          'phoneNumber',
          'showPhoneNumber',
          'profilePhotoUrl',
          'username',
          'followersCount',
          'followingCount',
          'reviewsCount',
          'profileVisibility',
          'uploadedResourcesVisibility',
          'purchasedResourcesVisibility',
          'showActivity',
          'allowMessages'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'fullName',
              'college',
              'branch',
              'year',
              'bio',
              'specification',
              'lastProfileUpdate',
              'phoneNumber',
              'showPhoneNumber'
            ]);

      allow delete: if false;

      /*
       * SOCIAL GRAPH
       *
       * Follow relationships are created and removed only by
       * trusted Cloud Functions. Clients may read the relationship
       * documents needed to display followers/following state.
       */
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /following/{followingId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }


    /*
     * SERVER-ONLY COLLECTIONS
     */
    match /referrals/{referralId} {
      allow read, write: if false;
    }

    match /referral_rewards/{rewardId} {
      allow read, write: if false;
    }

    match /ad_rewards/{rewardId} {
      allow read, write: if false;
    }


    /*
     * PURCHASES
     */
    match /purchases/{purchaseId} {

      allow read: if request.auth != null
        && request.auth.uid == resource.data.buyerId;

      allow write: if false;
    }


    /*
     * ACADEMIC VAULT
     */
    match /academic_vault/{resourceId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.status == 'published';

      allow update: if request.auth != null
        && resource.data.uploaderId == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.uploaderId == request.auth.uid;
    }


    /*
     * RESOURCE RATINGS / REVIEWS
     *
     * Ratings are tied to a purchased resource.
     * A user can create/update only their own rating.
     * The marketplace/resource detail can read the latest reviews.
     */
    match /academic_vault/{resourceId}/ratings/{ratingId} {

      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == ratingId
        && exists(
          /databases/$(database)/documents/purchases/$(request.auth.uid + '_' + resourceId)
        )
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow delete: if request.auth != null
        && request.auth.uid == ratingId;
    }



    /*
     * CHAT
     */
      /*
       * CHAT
       *
       * Message privacy is enforced by Firestore Rules,
       * not only by the Flutter UI.
       */
      match /chats/{chatId} {

        function validParticipants(participants) {
          return participants is list
            && participants.size() == 2
            && participants[0] != participants[1]
            && request.auth.uid in participants;
        }

        function otherParticipant(participants) {
          return participants[0] == request.auth.uid
            ? participants[1]
            : participants[0];
        }

        function recipientAllowsMessages(participants) {
          return get(
            /databases/$(database)/documents/users/$(otherParticipant(participants))
          ).data.get('allowMessages', true) == true;
        }

        allow create: if request.auth != null
          && validParticipants(
            request.resource.data.participants
          )
          && recipientAllowsMessages(
            request.resource.data.participants
          );

        allow read: if request.auth != null
          && request.auth.uid in resource.data.participants;

        allow update: if request.auth != null
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants ==
             resource.data.participants;

        allow delete: if request.auth != null
          && request.auth.uid in resource.data.participants;

        match /messages/{messageId} {

          allow read: if request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants;

          allow create: if request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
            && recipientAllowsMessages(
              get(
                /databases/$(database)/documents/chats/$(chatId)
              ).data.participants
            );

          allow update, delete: if request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants;
        }
      }


    /*
     * SUPPORT
     */
    match /support/{documentId} {

      allow create: if request.auth != null;

      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }


    /*
     * DEFAULT DENY
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

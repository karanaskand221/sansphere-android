rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /*
     * USER PROFILES
     *
     * Used by the sansphere database.
     */
    match /users/{userId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }


    /*
     * REFERRAL RECORDS
     *
     * These should be created by Cloud Functions only.
     */
    match /referrals/{referralId} {
      allow read, write: if false;
    }

    match /referral_rewards/{rewardId} {
      allow read, write: if false;
    }


    /*
     * AD REWARDS
     *
     * Cloud Functions only.
     */
    match /ad_rewards/{rewardId} {
      allow read, write: if false;
    }


    /*
     * PURCHASES
     *
     * Users may see their own purchases.
     * Creation is server-only.
     */
    match /purchases/{purchaseId} {

      allow read: if request.auth != null
        && request.auth.uid == resource.data.buyerId;

      allow write: if false;
    }


    /*
     * ACADEMIC VAULT
     *
     * Metadata can be read by logged-in users.
     *
     * Creation/update/delete is restricted to the uploader.
     */
    match /academic_vault/{resourceId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.status == 'published';

      allow update, delete: if request.auth != null
        && resource.data.uploaderId == request.auth.uid;
    }


    /*
     * CHAT ROOMS
     */
    match /chats/{chatId} {

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.participants;


      match /messages/{messageId} {

        allow read, create: if request.auth != null;

        allow update, delete: if request.auth != null;
      }
    }


    /*
     * SUPPORT
     */
    match /support/{documentId} {

      allow create: if request.auth != null;

      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}

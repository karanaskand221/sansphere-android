rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    /*
     * Academic Vault
     *
     * IMPORTANT:
     * Reads are disabled here.
     *
     * Downloads must go through the Cloud Function
     * getPurchasedFileUrl(), which checks ownership
     * and returns a short-lived signed URL.
     */
    match /academic_vault/{categoryId}/{departmentId}/{semesterId}/{userId}/{resourceId}/{fileName} {

      /*
       * Direct reads are disabled.
       *
       * Purchased resources are accessed through the
       * getPurchasedFileUrl Cloud Function, which verifies
       * permanent ownership and generates a short-lived
       * signed URL.
       */
      allow read: if false;

      /*
       * Only the authenticated uploader may create/update
       * their own resource file.
       */
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024;

      /*
       * Only the uploader may directly delete their file.
       * Application-level resource deletion is additionally
       * protected by the delete Cloud Functions.
       */
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }


    /*
     * Profile photos
     *
     * Profile photos are intentionally publicly readable because
     * they are displayed on public profiles.
     *
     * Only the authenticated owner may create, update, or delete
     * their own profile photo.
     */
    match /profile_photos/{uid}/profile.jpg {

      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }


    /*
     * Everything else remains blocked.
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

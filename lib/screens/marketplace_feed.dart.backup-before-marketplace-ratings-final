  List<AcademicResource> _trendingResources(List<AcademicResource> resources) {
    final items = List<AcademicResource>.from(resources);

    items.sort((a, b) => b.downloadCount.compareTo(a.downloadCount));

    return items.take(6).toList();
  }

  List<AcademicResource> _topRatedResources(List<AcademicResource> resources) {
    final items = resources.where((resource) => resource.rating > 0).toList();

    items.sort((a, b) => b.rating.compareTo(a.rating));

    return items.take(6).toList();
  }

  List<AcademicResource> _freeResources(List<AcademicResource> resources) {
    return resources
        .where((resource) => _normalizedPrice(resource) == 0)
        .take(6)
        .toList();
  }

  List<AcademicResource> _recentlyAddedResources(
    List<AcademicResource> resources,
  ) {
    // The marketplace feed already receives resources in their
    // current backend/global-state ordering. Reverse that order
    // so the newest entries appear first without changing the
    // AcademicResource model or existing filtering behavior.
    return resources.reversed.take(6).toList();
  }


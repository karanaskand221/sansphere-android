  Widget _buildHeroSection(List<AcademicResource> resources) {
    final featured = resources.take(5).toList();

    return SliverToBoxAdapter(
      child: Column(
        children: [
          const SizedBox(height: 15),
          SizedBox(
            height: 183,
            child: ScrollConfiguration(
              behavior: const _MarketplaceScrollBehavior(),
              child: PageView.builder(
              controller: _pageController,
              itemCount: featured.length,
              onPageChanged: (index) {
                setState(() {
                  _currentCarouselIndex = index;
                });
              },
              itemBuilder: (context, index) {
                return _buildHeroCard(featured[index], index);
              },
            ),
          ),
          const SizedBox(height: 10),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: List.generate(
              featured.length,
              (index) => AnimatedContainer(
                duration: const Duration(milliseconds: 250),
                margin: const EdgeInsets.symmetric(horizontal: 3),
                height: 5,
                width: _currentCarouselIndex == index ? 23 : 5,
                decoration: BoxDecoration(
                  color: _currentCarouselIndex == index
                      ? _cyan
                      : Colors.white24,
                  borderRadius: BorderRadius.circular(5),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }


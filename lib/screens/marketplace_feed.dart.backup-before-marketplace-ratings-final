  static const Color _cyan = Color(0xFF00E5FF);
  static const Color _blue = Color(0xFF0088FF);
  static const Color _purple = Color(0xFF7C4DFF);

  @override
  void initState() {
    super.initState();
    _searchController.text = widget.globalState.searchQuery;
  }

  @override
  void dispose() {
    _searchController.dispose();
    _pageController.dispose();
    super.dispose();
  }

  void _openResource(AcademicResource resource) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => ResourceDetailScreen(
          resource: resource,
          globalState: widget.globalState,
        ),
      ),
    );
  }

  void _openUpload() {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => UploadResourceScreen(globalState: widget.globalState),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return ListenableBuilder(
      listenable: widget.globalState,
      builder: (context, _) {
        final resources = widget.globalState.filteredResources;

        return Scaffold(
          backgroundColor: _background,
          extendBody: true,
          body: SafeArea(
            bottom: false,
            child: CustomScrollView(
              physics: const BouncingScrollPhysics(),
              slivers: [
                _buildTopBar(),
                _buildSearchAndFilters(),
                _buildAcademicCategories(resources),
                if (resources.isNotEmpty) ...[
                  _buildHeroSection(resources),

                  _buildTrendingSection(resources),
                  _buildTopRatedSection(resources),
                  _buildFreeSection(resources),
                  _buildRecentlyAddedSection(resources),

                  _buildFeaturedHeader(resources.length),
                  _buildResourceList(resources),
                ] else
                  _buildEmptyState(),
                const SliverToBoxAdapter(child: SizedBox(height: 125)),
              ],
            ),
          ),
          floatingActionButton: _buildUploadButton(),
        );
      },
    );
  }


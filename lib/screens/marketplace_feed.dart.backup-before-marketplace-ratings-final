  int _normalizedPrice(AcademicResource resource) {
    final value = resource.price;

    if (!value.isFinite || value < 0) {
      return 0;
    }

    return value.round();
  }

  String _priceLabel(AcademicResource resource) {
    final price = _normalizedPrice(resource);
    return price == 0 ? 'FREE' : '$price SANCOINS';
  }

  String _badgeForResource(AcademicResource resource) {
    if (_normalizedPrice(resource) == 0) {
      return 'FREE';
    }

    if (resource.downloadCount >= 10) {
      return 'TRENDING';
    }

    if (resource.rating >= 4.5) {
      return 'VERIFIED';
    }

    return 'UPDATED';
  }

  Color _badgeColorForResource(AcademicResource resource) {
    final badge = _badgeForResource(resource);

    switch (badge) {
      case 'FREE':
        return Colors.greenAccent;
      case 'TRENDING':
        return Colors.orangeAccent;
      case 'VERIFIED':
        return Colors.greenAccent;
      default:
        return _cyan;
    }
  }

  Color _accentForResource(AcademicResource resource) {
    switch (resource.category) {
      case ResourceCategory.lectureNotes:
        return _cyan;
      case ResourceCategory.pyq:
        return _purple;
      case ResourceCategory.questionBank:
        return const Color(0xFF00E676);
      case ResourceCategory.testPaper:
        return const Color(0xFFFFAB40);
      case ResourceCategory.textbook:
        return const Color(0xFF40C4FF);
      case ResourceCategory.questionPaper:
        return const Color(0xFFEA80FC);
      case ResourceCategory.labManual:
        return const Color(0xFF69F0AE);
      case ResourceCategory.assignment:
        return const Color(0xFFFFD740);
      case ResourceCategory.other:
        return _cyan;
    }
  }

  String _formatCategoryName(ResourceCategory cat) {
    switch (cat) {
      case ResourceCategory.questionBank:
        return 'Question Bank';
      case ResourceCategory.pyq:
        return 'PYQ';
      case ResourceCategory.lectureNotes:
        return 'Lecture Notes';
      case ResourceCategory.textbook:
        return 'Textbook';
      case ResourceCategory.questionPaper:
        return 'Question Paper';
      case ResourceCategory.testPaper:
        return 'Test Paper';
      case ResourceCategory.labManual:
        return 'Lab Manual';
      case ResourceCategory.assignment:
        return 'Assignment';
      case ResourceCategory.other:
        return 'Other';
    }
  }

  IconData _getCategoryIcon(ResourceCategory cat) {
    switch (cat) {
      case ResourceCategory.questionBank:
        return Icons.quiz_rounded;
      case ResourceCategory.pyq:
        return Icons.description_rounded;
      case ResourceCategory.lectureNotes:
        return Icons.menu_book_rounded;
      case ResourceCategory.textbook:
        return Icons.book_rounded;
      case ResourceCategory.questionPaper:
        return Icons.article_rounded;
      case ResourceCategory.testPaper:
        return Icons.assignment_rounded;
      case ResourceCategory.labManual:
        return Icons.science_rounded;
      case ResourceCategory.assignment:
        return Icons.assignment_turned_in_rounded;
      case ResourceCategory.other:
        return Icons.insert_drive_file_rounded;
    }
  }

  IconData _iconForDepartment(String value) {
    final v = value.toLowerCase();

    if (v.contains('computer') || v.contains('software')) {
      return Icons.computer_rounded;
    }

    if (v.contains('electronic') || v.contains('electrical')) {
      return Icons.bolt_rounded;
    }

    if (v.contains('civil')) {
      return Icons.architecture_rounded;
    }

    if (v.contains('chemical')) {
      return Icons.science_rounded;
    }

    if (v.contains('mechanical')) {
      return Icons.precision_manufacturing_rounded;
    }

    if (v.contains('information') || v.contains('it')) {
      return Icons.memory_rounded;
    }

    return Icons.school_rounded;
  }

